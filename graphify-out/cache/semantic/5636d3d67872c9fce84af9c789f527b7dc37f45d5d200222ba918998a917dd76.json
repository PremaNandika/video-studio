{"nodes": [{"id": "subtitle_dev_handoff", "label": "Subtitle Studio Developer Handoff", "file_type": "document", "source_file": "subtitle-studio/DEV-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "subtitle_server_py", "label": "Subtitle Studio server.py (Flask API + job runner)", "file_type": "code", "source_file": "subtitle-studio/DEV-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-memory jobs dict + daemon worker threads; stop requires flag + taskkill /T /F + a command-line engine sweep because launcher shims respawn workers; an _awake_keeper thread calls SetThreadExecutionState every 50s because Windows sleep once stretched a run to 91 min."}, {"id": "erase_subs_py", "label": "erase_subs.py (detection + ProPainter erase, legacy)", "file_type": "code", "source_file": "subtitle-studio/DEV-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "subclean_py", "label": "subclean.py (cheap covers: blur/bar/Telea inpaint)", "file_type": "code", "source_file": "subtitle-studio/DEV-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recaption_py", "label": "recaption.py (whisper word timing to ASS captions + ffmpeg burn)", "file_type": "code", "source_file": "subtitle-studio/DEV-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "easyocr_craft", "label": "EasyOCR / CRAFT subtitle-band detection", "file_type": "code", "source_file": "subtitle-studio/DEV-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "28 sampled frames, keeps text rows recurring in >=30% of text frames (temporal consistency), lower 55% of frame only; uses full min/max extent of band boxes because percentile trimming leaked long lines; snaps to full width above 0.82*W."}, {"id": "propainter", "label": "ProPainter video inpainting", "file_type": "code", "source_file": "subtitle-studio/DEV-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best-quality frame-by-frame background rebuild but 3-10 s/frame (hours on long videos) and VRAM-hungry \u2014 deprecated in favor of VSR STTN magic erase; kept checkpoint-resumable via files/.erase-cache-<stem>/."}, {"id": "gpu_lock_serialization", "label": "GPU_LOCK single-job GPU serialization", "file_type": "rationale", "source_file": "subtitle-studio/DEV-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RTX 3050 Ti has only 4 GB VRAM so one GPU job at a time: GPU_LOCK in server.py plus wait_for_gpu() which also scans for foreign ProPainter/erase processes via PowerShell."}, {"id": "frameprefetcher_eof_patch", "label": "VSR FramePrefetcher EOF-deadlock patch", "file_type": "rationale", "source_file": "subtitle-studio/DEV-HANDOFF.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "backend/tools/video_io.py used a single (False,None) sentinel; once consumed the next read() blocked forever (triggered when container frame-count metadata overreports, e.g. -c copy cuts). Fixed with a _eof flag so read() keeps returning (False,None) after EOF. Must be re-applied if VSR is re-cloned."}], "edges": [{"source": "subtitle_dev_handoff", "target": "subtitle_server_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "subtitle-studio/DEV-HANDOFF.md", "source_location": null, "weight": 1.0}, {"source": "subtitle_dev_handoff", "target": "subtitle_index_html", "relation": "references", "confidence": "EXTRACTED", "confidence_score":