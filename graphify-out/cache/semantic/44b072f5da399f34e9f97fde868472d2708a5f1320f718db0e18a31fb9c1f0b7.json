{"nodes": [{"id": "dubbing_studio_readme", "label": "Dubbing Studio README (Local Voice-Clone Dubbing Tool)", "file_type": "document", "source_file": "dubbing-studio/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dubbing_app_py", "label": "dubbing-studio app.py (Gradio app + CLI pipeline)", "file_type": "code", "source_file": "dubbing-studio/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "download_model_py", "label": "download_model.py (resumable XTTS downloader)", "file_type": "code", "source_file": "dubbing-studio/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coqui's built-in downloader has no resume and restarts from scratch on a dropped connection; the included downloader resumes, and auto-accepts the Coqui license (COQUI_TOS_AGREED=1) so nothing blocks on a prompt."}, {"id": "xtts_v2", "label": "Coqui XTTS v2 voice-clone TTS model", "file_type": "code", "source_file": "dubbing-studio/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Released under the Coqui Public Model License (CPML): free for non-commercial use, commercial use requires a license from Coqui. Uses ~2-2.5 GB VRAM, fitting the 4 GB RTX 3050 Ti."}, {"id": "fal_ai_lipsync", "label": "fal.ai lip-sync service (downstream)", "file_type": "code", "source_file": "dubbing-studio/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "length_match", "label": "Length-match time-stretch (audio fitted to video length)", "file_type": "rationale", "source_file": "dubbing-studio/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dubbed audio is time-stretched pitch-preserved via ffmpeg atempo to exactly match video length so both drop straight into a lip-sync tool needing equal-length inputs; stretches >2x stay in tune but can sound unnatural, so scripts should roughly match the video's spoken length. Off switch: --no-fit."}, {"id": "numba_shim", "label": "numba pure-Python stand-in (Smart App Control workaround)", "file_type": "rationale", "source_file": "dubbing-studio/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows Smart App Control blocks the unsigned llvmlite.dll inside numba (a librosa dependency), which would kill the app at import. app.py detects this and swaps in a tiny pure-Python numba stand-in; XTTS never uses numba-accelerated librosa paths, so no quality/speed loss, and Smart App Control stays fully enabled."}], "edges": [{"source": "dubbing_studio_readme", "target": "dubbing_app_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "dubbing-studio/README.md", "source_location": null, "weight": 1.0}, {"source": "dubbing_studio_readme", "target": "download_model_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "dubbing-studio/README.md", "source_location": null, "weight": 1.0}, {"source": "dubbing_app_py", "target": "coqui_tts_package", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "dubbing-studio/README.md", "source_location": null, "weight": 1.0}, {"source": "dubbing_app_py", "target": "ffmpeg", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "dubbing-studio/README.md", "source_location": null, "weight": 1.0}, {"source": "dubbing_app_py", "target": "length_match", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "dubbing-studio/README.md", "source_location": null, "weight": 1.0}, {"source": "dubbing_app