{"nodes": [{"id": "creator_page", "label": "Creator Page (video-to-new-ad pipeline UI)", "file_type": "document", "source_file": "autoVSL/dashboard/static/creator.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns existing videos into new ads via a gated 4-step flow (clean subtitles -> new script -> dub -> result); nothing advances until the user approves each step, protecting source footage and paid spend. Calls /api/creator/library, /api/creator/meta, /api/script, /api/copywrite, /api/clean-subs, /api/clean-restore, /api/run (transcribe/dub/caption), /api/qc/ai-review, /api/edit, /api/upload, /api/jobs, /api/chat, /api/agent-note."}, {"id": "research_brand_agent", "label": "Research & Brand Agent (in-dashboard Claude chat)", "file_type": "rationale", "source_file": "autoVSL/dashboard/static/creator.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chat strategist embedded in Creator and Mission Control that knows the banks, research and brand; used for fresh hooks/angles/niches and teachable via a 'Teach - save to agent memory' pin (/api/agent-note). Sessions run through /api/chat with model=opus, mode=research, polled event streams."}, {"id": "claude_script_copywriter", "label": "Claude Brand-Aware Script Rewriter", "file_type": "rationale", "source_file": "autoVSL/dashboard/static/creator.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The /api/copywrite endpoint: every rewrite feeds Claude the full research (bank hooks & angles, brand offer, ad-conversion rules) plus the video's measured speaking pace. The fit meter computes the original speaker's words/sec from transcript length / video duration so the rewritten script fills the same runtime for clean lip-sync (target 90-105% of original word count)."}], "edges": [{"source": "creator_p