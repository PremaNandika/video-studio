ements", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/Wav2Lip/README.md", "source_location": null, "weight": 1.0}, {"source": "wav2lip_readme", "target": "wav2lip_evaluation_framework", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/Wav2Lip/README.md", "source_location": null, "weight": 1.0}], "hyperedges": []}