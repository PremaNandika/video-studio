{"nodes": [{"id": "wav2lip_readme", "label": "Wav2Lip README", "file_type": "document", "source_file": "tools/Wav2Lip/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "wav2lip_model", "label": "Wav2Lip Lip-Sync Model", "file_type": "rationale", "source_file": "tools/Wav2Lip/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highly accurate lip-sync for any identity, voice, language, CGI faces and synthetic voices. Trained on LRS2 at low face resolution, so lower-resolution inputs (--resize_factor) often give better results; --pads and --nosmooth exist because face-detection bounding boxes and over-smoothed detections cause chin cutoff and double-mouth artifacts."}, {"id": "wav2lip_gan_model", "label": "Wav2Lip + GAN Model", "file_type": "rationale", "source_file": "tools/Wav2Lip/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trade-off variant: slightly inferior lip-sync accuracy but better visual quality thanks to an additional visual-quality discriminator (~2 days training vs <1 day without)."}, {"id": "wav2lip_paper", "label": "A Lip Sync Expert Is All You Need (ACM MM 2020)", "file_type": "paper", "source_file": "tools/Wav2Lip/README.md", "source_location": null, "source_url": "https://doi.org/10.1145/3394171.3413532", "captured_at": null, "author": "Prajwal K R, Rudrabha Mukhopadhyay, Vinay P. Namboodiri, C.V. Jawahar", "contributor": null}, {"id": "sync_api", "label": "Sync.so Commercial Lipsync API", "file_type": "rationale", "source_file": "tools/Wav2Lip/README.md", "source_location": null, "source_url": "https://api.sync.so", "captured_at": null, "author": null, "contributor": null, "rationale": "Commercial hosted successor (model lipsync-2) offered because the open-source model is LRS2-licensed for non-commercial use only and the commercial version is much higher quality; accessed via syncsdk (Python) or @sync.so/sdk (TypeScript) with async job create/poll."}, {"id": "lrs2_dataset", "label": "LRS2 Dataset", "file_type": "rationale", "source_file": "tools/Wav2Lip/README.md", "source_location": null, "source_url": "http://www.robots.ox.ac.uk/~vgg/data/lip_reading/lrs2.html", "captured_at": null, "author": null, "contributor": null, "rationale": "Training dataset for Wav2Lip; BBC copyright forbids commercial use of models trained on it, which is why the whole open-source repo is research-only."}, {"id": "expert_syncnet_discriminator", "label": "Expert Lip-Sync Discriminator", "file_type": "rationale", "source_file": "tools/Wav2Lip/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be trained (color_syncnet_train.py) before Wav2Lip itself, per-dataset; eval loss should reach ~0.25 and Wav2Lip sync loss ~0.2 for good results \u2014 the paper's core claim is that a strong pre-trained sync expert is what makes in-the-wild lip-sync work."}, {"id": "s3fd_face_detector", "label": "S3FD Face Detection Model", "file_type": "rationale", "source_file": "tools/Wav2Lip/README.md", "source_location": null, "source_url": "https://www.adrianbulat.com/downloads/python-fan/s3fd-619a316812.pth", "captured_at": null, "author": null, "contributor": null}, {"id": "deepvoice3_pytorch_repo", "label": "deepvoice3_pytorch TTS Repository", "file_type": "code", "source_file": "tools/Wav2Lip/README.md", "source_location": null, "source_url": "https://github.com/r9y9/deepvoice3_pytorch", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "wav2lip_readme", "target": "wav2lip_paper", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/Wav2Lip/README.md", "source_location": null, "weight": 1.0}, {"source": "wav2lip_model", "target": "wav2lip_paper", "relation": "implemen