{"nodes": [{"id": "raindrop_method", "label": "Raindrop Method Framework Reference", "file_type": "document", "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "their_why", "label": "'Their Why' Identity Inversion", "file_type": "rationale", "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": "section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "People don't buy the brand's why; they buy their own \u2014 who they are and hope to become. Value props are phrased as identity statements, ingredients are reasons-to-believe not reasons-to-buy."}, {"id": "brand_world", "label": "Brand World (Enterable Identity)", "file_type": "rationale", "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The strongest DTC identities are enterable places/states, not slogans: they give every asset a consistent fictional container, convert purchase into entry (belonging mechanics), and extend infinitely since new products are new rooms in the same world."}, {"id": "mascot_theory", "label": "Mascot Theory (Barry Rule)", "file_type": "rationale", "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": "section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Playful edge with a premium floor: mascots are ownable (competitors can copy a palette overnight but not accumulated character meaning) and enable cheap creative variation; the premium guardrail must always be written down."}, {"id": "channel_sequencing", "label": "Channel Sequencing (Gruns Arc)", "file_type": "rationale", "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": "section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DTC + email first to prove the identity converts, retail second, broadcast third \u2014 mass media amplifies distribution that already exists; buying broadcast before DTC proof is an anti-pattern."}, {"id": "raindrop_agency", "label": "Raindrop Agency (San Diego)", "file_type": "rationale", "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gruns", "label": "Gruns Case Study", "file_type": "rationale", "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raindrop partnered at Seed stage, built strategy/identity/mascot/performance creative; launched gummies Aug 2023, sold to Unilever for ~$1.2B in under three years \u2014 the evidence base for the whole method."}], "edges": [{"source": "raindrop_method", "target": "their_why", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": "section 1", "weight": 1.0}, {"source": "raindrop_method", "target": "brand_world", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": "section 3", "weight": 1.0}, {"source": "raindrop_method", "target": "mascot_theory", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": "section 4", "weight": 1.0}, {"source": "raindrop_method", "target": "channel_sequencing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": "section 6", "weight": 1.0}, {"source": "raindrop_method", "target": "token_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": "section 5", "weight": 1.0}, {"source": "raindrop_method", "target": "raindrop_agency", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": null, "weight": 1.0}, {"source": "raindrop_method", "target": "gruns", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": null, "weight": 1.0}, {"source": "raindrop_agency", "target": "gruns", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "autoVSL/.claude/skills/brand-platform-builder/references/raindrop-method.md", "source_location": null, "weight": 1.0}], "hyperedges": []}