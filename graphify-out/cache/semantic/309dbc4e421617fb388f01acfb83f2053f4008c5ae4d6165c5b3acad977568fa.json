{"nodes": [{"id": "copywriter_principles_prompt", "label": "AI Copywriter Prompt (10 Principles)", "file_type": "document", "source_file": "autoVSL/framework/stages/3-angles/copywriter-principles-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ten_copywriting_principles", "label": "10 Copywriting Principles", "file_type": "rationale", "source_file": "autoVSL/framework/stages/3-angles/copywriter-principles-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session-level operating rules: mass-America simplicity (FK ~6.5), extreme specificity, rewrite proven winners by studying their psychology, match winning length, no yes-man behavior, avatar language, one core idea per VSL. Installed at Stage 3 start and reused by every later stage."}, {"id": "emotional_arc_fhba", "label": "Emotional Arc: Fear \u2192 Hope \u2192 Belief \u2192 Action", "file_type": "rationale", "source_file": "autoVSL/framework/stages/3-angles/copywriter-principles-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every winning VSL hits these four emotional beats in order; each rewrite is mapped against the arc, and Stage 4 script files must include the arc map."}, {"id": "say_it_out_loud_test", "label": "Say It Out Loud Test", "file_type": "rationale", "source_file": "autoVSL/framework/stages/3-angles/copywriter-principles-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VSLs are heard, not read \u2014 any line that sounds weird spoken aloud by a 55-year-old man in Ohio must be rewritten. Part of Stage 4's done-when checklist."}, {"id": "compliance_guardrails", "label": "Compliance Guardrails (FTC / words-to-avoid)", "file_type": "rationale", "source_file": "autoVSL/framework/stages/3-angles/copywriter-principles-prompt.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stay FTC-compliant and avoid words that trigger ad-account issues (e.g. say 'flower' instead of THC); the words-to-avoid list lives in the offer doc."}], "edges": [{"source": "copywriter_principles_prompt", "target": "ten_copywriting_principles", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "autoVSL/framework/stages/3-angles/copywriter-principles-prompt.md", "source_location": null, "weight": 1.0}, {"source": "copywriter_principles_prompt", "target": "emotional_arc_fhba", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "autoVSL/framework/stages/3-angles/copywriter-principles-prompt.md", "source_location": null, "weight": 1.0}, {"source": "copywriter_principles_prompt", "target": "say_it_out_loud_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "autoVSL/framework/stages/3-angles/copywriter-principles-prompt.md", "source_location": null, "weight": 1.0}, {"source": "copywriter_principles_prompt", "target": "compliance_guardrails", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "autoVSL/framework/stages/3-angles/copywriter-principles-prompt.md", "source_location": null, "weight": 1.0}], "hyperedges": []}