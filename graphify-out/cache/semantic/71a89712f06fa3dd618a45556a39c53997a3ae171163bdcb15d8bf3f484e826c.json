, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brand_content_py", "label": "brand_content.py (Brand Studio Engine)", "file_type": "code", "source_file": "PROJECT-SUMMARY.md", "source_location": "video-studio/app/engines/brand_content.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "object_repair_py", "label": "object_repair.py (Object-Only Pixel Restore)", "file_type": "code", "source_file": "PROJECT-SUMMARY.md", "source_location": "video-studio/app/engines/object_repair.py", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restores only a damaged object's pixels from the original while preserving the dub's lip-sync; invariants (NCC tracking anchored to Claude-vision keyframes, damage-based mouth-protection gate, temporal smoothing) were each earned by a real observed failure such as tracker drift and interpolated lips."}, {"id": "frame_swap_py", "label": "frame_swap.py (1:1 Frame Range Swap)", "file_type": "code", "source_file": "PROJECT-SUMMARY.md", "source_location": "video-studio/app/engines/frame_swap.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "visual_repair_py", "label": "visual_repair.py (Keep-Dub-Lips Repair)", "file_type": "code", "source_file": "PROJECT-SUMMARY.md", "source_location": "video-studio/app/engines/visual_repair.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dubsync_repair_py", "label": "dubsync_repair.py (Relipsync/Refit/Renorm/Remux)", "file_type": "code", "source_file": "PROJECT-SUMMARY.md", "source_location": "video-studio/app/engines/dubsync_repair.py", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "xtts_engine", "label": "Coqui XTTS v2 (Local Voice Clone/TTS)", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "wav2lip", "label": "Wav2Lip (Local Lip-Sync)", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stock inference.py aborted on face-less frames (product end-cards); patched locally to reuse the nearest detection, raising only if no frame has a face."}, {"id": "gfpgan", "label": "GFPGAN (Face Restoration)", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "comfyui", "label": "ComfyUI + SD1.5 (Brand Imagery Generation)", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs --lowvram on a 4 GB RTX 3050 Ti; portable build shipped cu130 torch and was downgraded to cu126. SD1.5 cannot render text at this VRAM, so the model never draws brand text \u2014 text is composited deterministically instead."}, {"id": "faster_whisper", "label": "faster-whisper (CUDA Transcription)", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Word alignment crashes (IndexError in find_alignment) on XTTS silence; caption.py retries and falls back to segment-level timing."}, {"id": "falai", "label": "fal.ai (Paid Cloud Media Engines)", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paid engines sit behind explicit cost-confirmation gates and a spend tracker; the design default is free/local engines first."}, {"id": "headless_claude_cli", "label": "Headless Claude CLI (claude -p)", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All LLM work (script rewriting, clone-script generation, DubSync vision advisor) uses the user's Claude subscription CLI instead of an API key; CLAUDECODE must be popped from env for nested runs."}, {"id": "dub_workdir", "label": "Dub Workdir (script-swap/<stem>/ Data Structure)", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The central data structure: a workdir with final.mp4 automatically appears in every tab; new features are told to create/extend workdirs rather than invent new storage, and stage caching in the workdir makes jobs resumable without re-running paid stages."}, {"id": "frame_count_integrity", "label": "Frame-Count Integrity Rule", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": "section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ffmpeg -shortest silently dropped trailing frames (660 to 657), so it is banned project-wide; encoders use -frames:v N, readers die loudly on early EOF, and every engine ffprobe-verifies output frame count equals input, deleting the take on mismatch."}, {"id": "money_gate", "label": "Cost-Confirmation Money Gate + Spend Tracker", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any fal.ai action requires confirm_cost: true in the request body; run_dub_job appends estimated cost to a running total, and cloud dubs are deliberately excluded from blind resume so money is never spent without explicit confirmation."}, {"id": "gpu_lock", "label": "GPU Lock / Cross-App Arbitration", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One GPU job at a time on the 4 GB RTX 3050 Ti: concurrent XTTS/Wav2Lip runs OOM the card and all fail, so the 409 guard and cross-app lock file are load-bearing."}, {"id": "clone_winner", "label": "Clone Winner Feature (Ad Variant Factory)", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": "section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mass-produces variants of a proven ad keeping structure/angle/claims with fresh wording; same-actor fal runs copy voice.json to skip the $1.50 re-clone fee, and clone endpoints call engine scripts directly with --name to bypass the server's upload-derived stem."}, {"id": "dubsync_repair_suite", "label": "DubSync Repair Suite", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": "section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixes finished dubs without paying for a re-dub; every repair writes a take (repair-*.mp4) and never overwrites final.mp4 until promoted, so a bad repair can never destroy the deliverable."}, {"id": "brand_studio", "label": "Brand Studio (Static Image Ads)", "file_type": "rationale", "source_file": "PROJECT-SUMMARY.md", "source_location": "section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because SD1.5 on 4 GB VRAM cannot render text, the model only generates imagery; all brand text and the locked liitt wordmark PNG are overlaid deterministically with Pillow using brand-kit tokens, hard-failing on missing tokens rather than silently substituting."}], "edges": [{"source": "project_summary", "target": "server_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "PROJECT-SUMMARY.md", "source_location": "sec