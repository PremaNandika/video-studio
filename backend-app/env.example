# Backend-app environment template.
# Copy to .env and fill in. Never commit .env (gitignored).

# Server bind. The live video-studio app is on 5180; the new backend uses
# 5181 during Phase 1 to avoid collision. Phase 3d cuts over to 5180.
PORT=5181
HOST=127.0.0.1

# Flask mode. 'development' enables auto-reload; 'production' disables it.
FLASK_ENV=development

# Real values land here as services are extracted in Phase 1:
#   FAL_KEY=...                 (spend.py — read from autoVSL/.env, not duplicated)
#   VIDEO_STUDIO_DATA_ROOT=...  (workdir.py — defaults to ../autoVSL)
#   COMFYUI_URL=...             (brand studio)
#   REMOTE_PIN=...              (auth blueprint)
